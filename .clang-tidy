---
# Clang-Tidy configuration for antipodal.
#
# Goal: catch real bugs and enforce modern C++20 idioms without drowning the
# editor in style nitpicks. The codebase is a header-only template-heavy math
# library, so checks that fire constantly on numeric/template code (magic
# numbers, easily-swappable params, cognitive complexity, identifier naming,
# implicit narrowings) are disabled here — they have a poor signal-to-noise
# ratio in this domain.
#
# YAML notes for the Checks field:
#   - ">-" is a folded block scalar — newlines fold to spaces, no trailing nl
#   - All entries must share the same indentation
#   - "-checkname" subtracts a check from a wildcard group
#   - Don't quote individual entries; that breaks YAML parsing

Checks: >-
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-chained-comparison,
  -bugprone-macro-parentheses,
  -bugprone-sizeof-expression,

  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -modernize-use-nodiscard,
  -modernize-pass-by-value,

  performance-*,

  misc-const-correctness,
  misc-definitions-in-headers,
  misc-header-include-cycle,
  misc-include-cleaner,
  misc-misplaced-const,
  misc-redundant-expression,
  misc-static-assert,
  misc-unconventional-assign-operator,
  misc-unused-alias-decls,
  misc-unused-using-decls,

  readability-avoid-const-params-in-decls,
  readability-const-return-type,
  readability-container-contains,
  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-duplicate-include,
  readability-misleading-indentation,
  readability-misplaced-array-index,
  readability-non-const-parameter,
  readability-redundant-control-flow,
  readability-redundant-declaration,
  readability-redundant-function-ptr-dereference,
  readability-redundant-member-init,
  readability-redundant-preprocessor,
  readability-redundant-smartptr-get,
  readability-redundant-string-cstr,
  readability-redundant-string-init,
  readability-simplify-subscript-expr,
  readability-static-accessed-through-instance,
  readability-static-definition-in-anonymous-namespace,
  readability-string-compare

# Disabled-with-rationale:
#   bugprone-easily-swappable-parameters — fires on every (a, b) math signature
#       (dot, cross, min/max, integration bounds, ...); zero signal here.
#   bugprone-chained-comparison       — doctest CHECK() expands to a chain of <<.
#   bugprone-macro-parentheses        — clashes with doctest's spaceship macros.
#   bugprone-sizeof-expression        — we use sizeof(T)==sizeof(U) intentionally.
#   modernize-use-trailing-return-type — stylistic; we use leading return types.
#   modernize-avoid-c-arrays          — small local C arrays are fine (int tri[3]).
#   modernize-use-nodiscard           — we annotate [[nodiscard]] by hand where
#                                       it matters; no auto-suggestion noise.
#   modernize-pass-by-value           — noisy on small templated arithmetic types.
#
# Identifier-naming intentionally NOT enforced. The repo uses CamelCase for
# behavior structs (NaiveIntersector, PoolDispatcher, SinglethreadDispatcher)
# and lower_case for value/data structs (vec3, fwd_diff, weighted_segment3,
# integrate_config). The distinction is by feel and not worth encoding.
#
# cppcoreguidelines-* intentionally NOT enabled. The few useful checks
# (pro-type-cstyle-cast, special-member-functions) are largely covered by
# bugprone-/modernize-/readability-. The rest (avoid-magic-numbers,
# pro-bounds-pointer-arithmetic, init-variables) fires constantly on math code.

# Promote the small set of always-bugs to errors. Most warnings stay as
# warnings so we can fix them incrementally.
WarningsAsErrors: >-
  bugprone-return-const-ref-from-parameter,
  misc-definitions-in-headers

CheckOptions:
  # Flag std::move on trivially copyable types — common foot-gun in math code
  # where we shuffle small POD vectors around.
  - key: performance-move-const-arg.CheckTriviallyCopyableMove
    value: true

  # The codebase prefers default-member-init via "= value" over constructor
  # initializer lists for simple cases (e.g., int m_thread_count = 0).
  - key: modernize-use-default-member-init.UseAssignment
    value: true
